/* =========================================================
   WASILI DISPATCHER PORTAL
   Victor's independent frontend implementation
   ========================================================= */

:root {
    --green-900: #064e3b;
    --green-800: #065f46;
    --green-700: #047857;
    --green-600: #059669;
    --green-500: #10b981;
    --green-100: #d1fae5;
    --green-50: #ecfdf5;

    --white: #ffffff;
    --gray-50: #f8fafc;
    --gray-100: #f1f5f9;
    --gray-200: #e2e8f0;
    --gray-300: #cbd5e1;
    --gray-400: #94a3b8;
    --gray-500: #64748b;
    --gray-600: #475569;
    --gray-700: #334155;
    --gray-800: #1e293b;
    --gray-900: #0f172a;

    --warning: #f59e0b;
    --danger: #ef4444;

    --sidebar-width: 250px;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.08);
    --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.08);
}


/* =========================================================
   RESET
   ========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    background: var(--gray-50);
    color: var(--gray-900);
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}


/* =========================================================
   APP LAYOUT
   ========================================================= */

.app {
    min-height: 100vh;
    display: flex;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar {
    position: fixed;
    inset: 0 auto 0 0;

    width: var(--sidebar-width);

    display: flex;
    flex-direction: column;

    background: var(--white);
    border-right: 1px solid var(--gray-200);

    z-index: 100;
}


/* =========================================================
   BRAND
   ========================================================= */

.brand {
    display: flex;
    align-items: center;

    gap: 12px;

    padding: 24px 20px;

    border-bottom: 1px solid var(--gray-200);
}

.brand-mark {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--green-600);
    color: var(--white);

    border-radius: 11px;

    font-size: 1.3rem;
    font-weight: 800;
}

.brand-text h1 {
    font-size: 1.15rem;
    line-height: 1.2;
}

.brand-text span {
    display: block;

    margin-top: 3px;

    color: var(--gray-500);

    font-size: 0.72rem;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

.navigation {
    display: flex;
    flex-direction: column;

    gap: 6px;

    padding: 20px 12px;
}

.nav-item {
    width: 100%;

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 12px 14px;

    border: 0;
    border-radius: var(--radius-sm);

    background: transparent;

    color: var(--gray-600);

    font-size: 0.9rem;
    font-weight: 600;

    text-align: left;

    cursor: pointer;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}

.nav-item span:first-child {
    width: 22px;

    display: flex;
    justify-content: center;

    font-size: 1.1rem;
}

.nav-item:hover {
    background: var(--gray-100);
    color: var(--green-700);
}

.nav-item.active {
    background: var(--green-50);
    color: var(--green-700);
}

.nav-item.active span:first-child {
    color: var(--green-600);
}


/* =========================================================
   SIDEBAR FOOTER
   ========================================================= */

.sidebar-bottom {
    margin-top: auto;

    padding: 16px;

    border-top: 1px solid var(--gray-200);
}

.dispatcher-profile {
    display: flex;
    align-items: center;

    gap: 11px;

    padding: 10px;

    border-radius: var(--radius-sm);

    background: var(--gray-50);
}

.avatar {
    width: 38px;
    height: 38px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: var(--green-100);
    color: var(--green-800);

    font-size: 0.75rem;
    font-weight: 800;
}

.dispatcher-profile strong {
    display: block;

    font-size: 0.82rem;
}

.dispatcher-profile small {
    display: block;

    margin-top: 2px;

    color: var(--gray-500);

    font-size: 0.68rem;
}


/* =========================================================
   MAIN
   ========================================================= */

.main {
    width: calc(100% - var(--sidebar-width));

    margin-left: var(--sidebar-width);

    min-height: 100vh;
}


/* =========================================================
   TOPBAR
   ========================================================= */

.topbar {
    position: sticky;
    top: 0;

    min-height: 90px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 20px 34px;

    background: rgba(255, 255, 255, 0.96);

    border-bottom: 1px solid var(--gray-200);

    backdrop-filter: blur(8px);

    z-index: 50;
}

.eyebrow {
    margin-bottom: 4px;

    color: var(--green-600);

    font-size: 0.65rem;
    font-weight: 800;

    letter-spacing: 0.12em;
}

.topbar h2 {
    font-size: 1.45rem;
    line-height: 1.25;
}

.topbar p:last-child {
    margin-top: 4px;

    color: var(--gray-500);

    font-size: 0.82rem;
}

.topbar-status {
    display: flex;
    align-items: center;

    gap: 8px;

    padding: 8px 12px;

    border: 1px solid var(--green-100);
    border-radius: 999px;

    background: var(--green-50);

    color: var(--green-700);

    font-size: 0.75rem;
    font-weight: 700;
}

.status-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--green-500);

    box-shadow: 0 0 0 3px var(--green-100);
}


/* =========================================================
   CONTENT
   ========================================================= */

.content {
    max-width: 1500px;

    margin: 0 auto;

    padding: 32px;
}


/* =========================================================
   SECTIONS
   ========================================================= */

.portal-section {
    display: none;
}

.portal-section.active {
    display: block;
}

.section-heading {
    margin-bottom: 24px;
}

.section-heading h3 {
    font-size: 1.35rem;
}

.section-heading p {
    margin-top: 5px;

    color: var(--gray-500);

    font-size: 0.85rem;
}


/* =========================================================
   STATISTICS
   ========================================================= */

.stats-grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 16px;

    margin-bottom: 24px;
}

.stat-card {
    padding: 20px;

    background: var(--white);

    border: 1px solid var(--gray-200);

    border-radius: var(--radius-md);

    box-shadow: var(--shadow-sm);
}

.stat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    color: var(--gray-500);

    font-size: 0.78rem;
    font-weight: 600;
}

.stat-icon {
    width: 32px;
    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: var(--green-50);

    color: var(--green-600);

    font-weight: 800;
}

.stat-icon.warning {
    background: #fffbeb;
    color: var(--warning);
}

.stat-card > strong {
    display: block;

    margin-top: 12px;

    font-size: 2rem;
    line-height: 1;
}

.stat-card > small {
    display: block;

    margin-top: 8px;

    color: var(--gray-500);

    font-size: 0.72rem;
}


/* =========================================================
   PANELS
   ========================================================= */

.panel {
    margin-top: 20px;

    background: var(--white);

    border: 1px solid var(--gray-200);

    border-radius: var(--radius-md);

    box-shadow: var(--shadow-sm);

    overflow: hidden;
}

.panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding: 20px 22px;

    border-bottom: 1px solid var(--gray-200);
}

.panel-header h3 {
    font-size: 0.95rem;
}

.panel-header p {
    margin-top: 4px;

    color: var(--gray-500);

    font-size: 0.75rem;
}


/* =========================================================
   BUTTONS
   ========================================================= */

button {
    font-family: inherit;
}

.secondary-button {
    padding: 8px 13px;

    border: 1px solid var(--gray-300);

    border-radius: var(--radius-sm);

    background: var(--white);

    color: var(--gray-700);

    font-size: 0.75rem;
    font-weight: 700;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease;
}

.secondary-button:hover {
    background: var(--gray-50);
    border-color: var(--green-300);
    color: var(--green-700);
}


/* =========================================================
   TABLE
   ========================================================= */

.table-container {
    width: 100%;

    overflow-x: auto;
}

table {
    width: 100%;

    border-collapse: collapse;

    min-width: 720px;
}

thead {
    background: var(--gray-50);
}

th {
    padding: 12px 18px;

    color: var(--gray-500);

    font-size: 0.68rem;
    font-weight: 700;

    text-align: left;

    text-transform: uppercase;

    letter-spacing: 0.04em;

    white-space: nowrap;
}

td {
    padding: 15px 18px;

    border-top: 1px solid var(--gray-100);

    color: var(--gray-700);

    font-size: 0.78rem;

    white-space: nowrap;
}

tbody tr:hover {
    background: var(--gray-50);
}

.empty {
    padding: 35px;

    text-align: center;

    color: var(--gray-400);
}


/* =========================================================
   REQUEST / RIDER / ASSIGNMENT LISTS
   ========================================================= */

.request-list,
.rider-list,
.assignment-list {
    display: grid;

    gap: 16px;
}

.empty-panel {
    padding: 50px 20px;

    background: var(--white);

    border: 1px dashed var(--gray-300);

    border-radius: var(--radius-md);

    color: var(--gray-500);

    text-align: center;

    font-size: 0.85rem;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

}


@media (max-width: 768px) {

    :root {
        --sidebar-width: 0px;
    }

    .sidebar {
        display: none;
    }

    .main {
        width: 100%;
        margin-left: 0;
    }

    .topbar {
        padding: 18px 20px;
    }

    .topbar-status {
        display: none;
    }

    .content {
        padding: 22px 18px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

}


@media (max-width: 480px) {

    .topbar h2 {
        font-size: 1.2rem;
    }

    .section-heading h3 {
        font-size: 1.15rem;
    }

    .panel-header {
        align-items: flex-start;
        flex-direction: column;
    }

}


/* =========================================================
   WASILI DISPATCHER - REQUEST CARD
   ========================================================= */

.request-card {
    overflow: hidden;
    margin-bottom: 24px;
}

.request-card .panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 32px;
}

.request-card .panel-header > div:first-child {
    min-width: 0;
}

.request-card .panel-header h3 {
    margin: 0 0 6px;
    line-height: 1.25;
}

.request-card .panel-header p {
    margin: 0;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.request-card .request-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 24px 32px;
    border-top: 1px solid var(--gray-200);
}

.request-card .request-details > div {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.request-card .request-details small {
    display: block;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.request-card .request-details strong {
    display: block;
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.45;
    font-weight: 600;
    color: var(--gray-900);
    overflow-wrap: anywhere;
    word-break: break-word;
}

.request-card .card-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 18px 32px 24px;
}

.request-card .assign-button {
    min-width: 130px;
}

@media (max-width: 900px) {
    .request-card .request-details {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .request-card .panel-header {
        padding: 22px;
        gap: 14px;
    }

    .request-card .request-details {
        grid-template-columns: 1fr;
        padding: 20px 22px;
        gap: 16px;
    }

    .request-card .card-actions {
        justify-content: stretch;
        padding: 16px 22px 22px;
    }

    .request-card .assign-button {
        width: 100%;
    }
}


/* =========================================================
   WASILI DISPATCHER - RIDER CARD
   ========================================================= */

.rider-card {
    overflow: hidden;
    margin-bottom: 24px;
}

.rider-card .panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 32px;
    border-bottom: 1px solid var(--gray-200);
}

.rider-card .panel-header > div:first-child {
    min-width: 0;
}

.rider-card .panel-header h3 {
    margin: 0 0 6px;
    line-height: 1.3;
}

.rider-card .panel-header p {
    margin: 0;
    line-height: 1.5;
    color: var(--gray-500);
}

.rider-card .rider-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 24px 32px;
}

.rider-card .rider-details > div {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.rider-card .rider-details small {
    display: block;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.rider-card .rider-details strong {
    display: block;
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
    font-weight: 600;
    color: var(--gray-900);
    overflow-wrap: anywhere;
}

.rider-card .capacity-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 0 32px 12px;
    color: var(--gray-600);
    font-size: 0.92rem;
    line-height: 1.4;
}

.rider-card .capacity-info span {
    display: block;
}

.rider-card .capacity-bar {
    height: 8px;
    margin: 0 32px 28px;
    overflow: hidden;
    background: var(--gray-200);
    border-radius: 999px;
}

.rider-card .capacity-fill {
    height: 100%;
    min-width: 0;
    border-radius: inherit;
    background: var(--green-500);
    transition: width 0.25s ease;
}

@media (max-width: 900px) {
    .rider-card .rider-details {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .rider-card .panel-header {
        padding: 22px;
        gap: 14px;
    }

    .rider-card .rider-details {
        grid-template-columns: 1fr;
        padding: 20px 22px;
        gap: 18px;
    }

    .rider-card .capacity-info {
        padding: 0 22px 12px;
    }

    .rider-card .capacity-bar {
        margin: 0 22px 22px;
    }
}

/* =========================================================
   WASILI DISPATCHER - FINAL CARD LAYOUT FIX
   ========================================================= */

.request-card,
.rider-card {
    width: 100%;
    overflow: hidden;
    margin-bottom: 24px;
}

/* Card headers */
.request-card .panel-header,
.rider-card .panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
