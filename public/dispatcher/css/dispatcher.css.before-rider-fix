    display: block;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--gray-500);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* Detail values */
.request-card .request-details strong,
.rider-card .rider-details strong {
    display: block;
    margin: 0;
